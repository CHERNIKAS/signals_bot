# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# App
SCHEDULE_MINUTES=1
POLLING_RETRY_SECONDS=10
FRESH_ONLY=0
WORKERS=8
EVAL_TIMEOUT=20
TICK_TIMEOUT=180

# Postgres for docker-compose
POSTGRES_DB=signal_bot
POSTGRES_USER=signal_bot
POSTGRES_PASSWORD=signal_bot_pass

# Database connection for bot
DATABASE_URL=postgresql://signal_bot:signal_bot_pass@postgres:5432/signal_bot
PGSSL=disable
